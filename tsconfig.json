{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist/lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/berry_generator.ts",
    "src/blocks.ts",
    "src/library.ts",
    "src/toolbox.ts",
    "src/device_profiles.ts",
    "src/active_profile.ts",
    "src/brand.ts",
    "src/project.ts",
    "src/preview.ts",
    "src/embed.ts"
  ]
}
