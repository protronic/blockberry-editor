{
  "name": "@protronic/blockberry-editor",
  "version": "1.0.0",
  "description": "Blockly backend that generates Berry scripts for small IoT control and escalation systems",
  "type": "module",
  "main": "./dist/lib/library.js",
  "types": "./dist/lib/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/library.d.ts",
      "import": "./dist/lib/library.js"
    },
    "./toolbox": "./dist/lib/toolbox.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "pnpm run build:lib && pnpm run build:web",
    "build:lib": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "check:types": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run check:types && pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protronic/blockberry-editor.git"
  },
  "keywords": [
    "blockly",
    "berry",
    "tasmota",
    "canopen",
    "lvgl",
    "plc"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/protronic/blockberry-editor/issues"
  },
  "homepage": "https://github.com/protronic/blockberry-editor#readme",
  "dependencies": {
    "blockly": "^13.1.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@opencloud-eu/extension-sdk": "^7.0.0",
    "@opencloud-eu/tsconfig": "^7.0.0",
    "@opencloud-eu/web-client": "^7.0.0",
    "@opencloud-eu/web-pkg": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "packageManager": "pnpm@10.33.3"
}
